<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9' xmlns:experimental="http://sdformat.org/schemas/experimental">
  <model name='x500_nadir2_flow'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500_mono_cam</uri>
      <experimental:params>
        <!-- modify nie dodaje elementu nieobecnego w pinie (sdformat14, Error Code 8); replace = kopia czujnika z pinu 3354ae1e + maska -->
        <sensor element_id="camera_link::imager" action="replace" name="imager" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
          <visibility_mask>4294967293</visibility_mask>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
      </experimental:params>
    </include>
    <include merge='true'>
      <uri>model://optical_flow</uri>
      <pose relative_to="base_link">0.03 0 -0.1 0 0 0</pose>
      <experimental:params>
        <!-- NADIR: kopia czujnika flow_camera z optical_flow/model.sdf + maska ~bit 2 (znaczniki niewidoczne dla przepływu) -->
        <sensor element_id="flow_link::flow_camera" action="replace" name="flow_camera" type="camera">
        <pose>0 0 0 0 1.5707 0</pose>
        <camera>
          <horizontal_fov>0.733038</horizontal_fov>
          <image>
            <width>100</width>
            <height>100</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>30</far>
          </clip>
          <visibility_mask>4294967291</visibility_mask>
        </camera>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
      </sensor>
      </experimental:params>
    </include>
    <include merge='true'>
      <uri>model://LW20</uri>
      <pose relative_to="base_link">0 0 -0.079 0 1.57 0</pose>
    </include>
    <joint name="optical_flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
      <pose relative_to="base_link">0 0 -0.1 0 1.5707 0</pose>
    </joint>
    <joint name="lidar_model_joint" type="fixed">
      <parent>base_link</parent>
      <child>lw20_link</child>
      <pose relative_to="base_link">-0 0 0 0 0 0</pose>
    </joint>
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.57  0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name='lidar' type='gpu_lidar'>
        <pose>0 0 0 3.14 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <!-- NADIR v2: druga kamera, oś −z_body, montaż pod płozy −0.215 m, 5 Hz (ANEKS_NADIR-1 §2.2–2.3) -->
    <link name="nadir_link">
      <pose relative_to="base_link">0 0 -0.215 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name="nadir" type="camera">
        <pose>0 0 0 0 1.5707963 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="nadir_joint" type="fixed">
      <parent>base_link</parent>
      <child>nadir_link</child>
    </joint>
  </model>
</sdf>
