<?xml version="1.0" ?>
<!-- r02/intruder_model.sdf — aktor-intruz R0.2 (R1), PODEJŚCIE POPRAWNE (model, nie gz <actor>).
     gz <actor> bez <skin> WYWALA serwer (SceneBroadcaster segfault na __default__ mesh) — patrz
     results/R02/r1_status.md. PRE §2.1 mówi „kinematyczny MODEL … pose-scripted … SetPose per krok symu".
     Model statyczny (physics OFF, brak grawitacji/kolizji-dynamiki) = renderuje się niezawodnie i nie
     pada; pozę steruje deterministycznie r02/intruder_driver.py (poza = f(sim_time) przez set_pose).
     Wizual = ciemny quad-UAV (kadłub + ramiona). Kolizja pominięta (nie potrzebna — intruz nie zderza się). -->
<sdf version="1.9">
  <model name="intruder">
    <static>true</static>
    <pose>12 0 10 0 0 0</pose>
    <link name="body">
      <visual name="hull">
        <geometry><box><size>0.7 0.7 0.25</size></box></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <visual name="arms">
        <geometry><box><size>1.1 0.08 0.05</size></box></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
